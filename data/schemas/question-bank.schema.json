{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://interviewx.local/schemas/question-bank.schema.json",
  "title": "QuestionBank",
  "type": "object",
  "additionalProperties": false,
  "required": ["roleId", "version", "questions"],
  "properties": {
    "roleId": {
      "type": "string",
      "enum": ["fresh", "senior", "pm", "dev", "sa", "qa", "dba", "ba"]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "questions": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "levels",
          "topic",
          "difficulty",
          "type",
          "prompt",
          "explanation",
          "rubric"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+-[a-z0-9-]+$" },
          "role": { "type": "string", "enum": ["fresh", "senior", "pm", "dev", "sa", "qa", "dba", "ba"] },
          "levels": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 }
          },
          "topic": { "type": "string", "minLength": 2 },
          "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
          "type": { "type": "string", "enum": ["mcq", "multi", "scenario", "sql", "code"] },
          "prompt": { "type": "string", "minLength": 12 },
          "hint": { "type": "string", "minLength": 4 },
          "explanation": { "type": "string", "minLength": 10 },
          "options": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-f]$" },
                "text": { "type": "string", "minLength": 1 }
              }
            }
          },
          "answerHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "answerObfuscated": { "type": "string", "minLength": 4 },
          "minSelections": { "type": "integer", "minimum": 2 },
          "datasetId": { "type": "string", "enum": ["employees", "orders_ops"] },
          "starterCode": { "type": "string" },
          "referenceSqlObfuscated": { "type": "string", "minLength": 4 },
          "expectedResult": {
            "type": "object",
            "additionalProperties": false,
            "required": ["columns", "rows", "orderMatters"],
            "properties": {
              "columns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": { "type": ["string", "number", "null"] }
                }
              },
              "orderMatters": { "type": "boolean" }
            }
          },
          "language": { "type": "string", "enum": ["javascript"] },
          "functionName": { "type": "string", "minLength": 1 },
          "testCases": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["args", "expected"],
              "properties": {
                "args": { "type": "array" },
                "expected": {}
              }
            }
          },
          "referenceCodeObfuscated": { "type": "string", "minLength": 4 },
          "minWords": { "type": "integer", "minimum": 10 },
          "keyPoints": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 2 }
          },
          "rubric": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "weight"],
              "properties": {
                "id": { "type": "string", "minLength": 2 },
                "label": { "type": "string", "minLength": 4 },
                "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
