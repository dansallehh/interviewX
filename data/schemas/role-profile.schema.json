{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://interviewx.local/schemas/role-profile.schema.json",
  "title": "RoleProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "code",
    "name",
    "shortName",
    "tagline",
    "focus",
    "motif",
    "accentHex",
    "rubricId",
    "levels",
    "sections"
  ],
  "properties": {
    "id": {
      "type": "string",
      "enum": ["fresh", "senior", "pm", "dev", "sa", "qa", "dba"]
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "shortName": {
      "type": "string",
      "minLength": 2
    },
    "tagline": {
      "type": "string",
      "minLength": 10
    },
    "focus": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 2 }
    },
    "motif": {
      "type": "string",
      "minLength": 3
    },
    "accentHex": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "rubricId": {
      "type": "string",
      "minLength": 3
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "summary", "durationMinutes", "questionCount", "passMark"],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "label": { "type": "string", "minLength": 2 },
          "summary": { "type": "string", "minLength": 10 },
          "durationMinutes": { "type": "integer", "minimum": 10, "maximum": 120 },
          "questionCount": { "type": "integer", "minimum": 4, "maximum": 30 },
          "passMark": { "type": "integer", "minimum": 50, "maximum": 95 }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "weight"],
        "properties": {
          "topic": { "type": "string", "minLength": 2 },
          "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
