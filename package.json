{
  "name": "interviewx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Role-based technical interview assessment platform hosted statically on GitHub Pages.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test tests/a11y",
    "test:e2e": "playwright test",
    "check:budget": "node scripts/check-budget.mjs",
    "gate:p1": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:budget && npm run test:a11y"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.2.6",
    "@fontsource/jetbrains-mono": "5.2.6",
    "@fontsource/space-grotesk": "5.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.25.0",
    "@playwright/test": "1.52.0",
    "@types/node": "22.15.3",
    "eslint": "9.25.0",
    "globals": "16.0.0",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.31.1",
    "vite": "6.3.5",
    "vitest": "3.1.3"
  }
}
